# Virtual Gallery — environment variables
#
# Copy to `.env.local` for local development. Never commit real values.
# Firebase Admin credentials belong in Application Default Credentials or a
# secrets manager — not in this file.
#
# Node: engines require >=22.15.0 (set Node 22 in Vercel Project Settings).

# ── Public (inlined into the client bundle) ─────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=virtual-gallery-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Point the client at local emulators when developing offline.
# MUST be unset or "false" on Vercel / any production host.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# ── Server only ─────────────────────────────────────────────────────────────
# Reserved (not read by app code today). Sessions use Firebase Admin cookies.
# SESSION_SECRET=

# Platform admin allowlist (comma-separated emails). Also grantable via
# Auth custom claim `platformAdmin` from the /admin panel or seed:admin.
ADMIN_EMAILS=admin@virtualgallery.dev

# Firebase Admin — preferred locally: GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
# On Vercel: paste the service-account JSON as a single line (escape newlines as \n).
# FIREBASE_ADMIN_CREDENTIALS=

# Stripe — leave empty locally to use mock billing (emulators or BILLING_MOCK).
# With keys set, Checkout + Customer Portal + webhook sync plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Force mock plan upgrades without emulators when Stripe is unset.
# BILLING_MOCK=true

# Optional site social URLs (footer + landing). Use full https:// URLs.
# Leave unset or "#" to show muted placeholders until you publish channels.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=#
NEXT_PUBLIC_SOCIAL_TWITTER=#
NEXT_PUBLIC_SOCIAL_LINKEDIN=#
NEXT_PUBLIC_SOCIAL_YOUTUBE=#
NEXT_PUBLIC_SOCIAL_BEHANCE=#

# Optional transactional email (welcome, enquiry, publish, weekly digest).
# Logs to console when unset.
RESEND_API_KEY=
EMAIL_FROM=Virtual Gallery <onboarding@virtual.gallery>

# Vercel Cron authorization for /api/cron/weekly-digest
# CRON_SECRET=

# ── Vercel production ───────────────────────────────────────────────────────
# Do NOT set NEXT_PUBLIC_USE_FIREBASE_EMULATORS, FIREBASE_AUTH_EMULATOR_HOST,
# FIRESTORE_EMULATOR_HOST, or FIREBASE_STORAGE_EMULATOR_HOST on Vercel.
#
# Required (Production + Preview if you use real Firebase there):
#   NEXT_PUBLIC_SITE_URL=https://YOUR_PROJECT.vercel.app
#   NEXT_PUBLIC_FIREBASE_API_KEY=
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID=virtual-gallery-prod   # or your prod id
#   NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
#   NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
#   NEXT_PUBLIC_FIREBASE_APP_ID=
#   FIREBASE_ADMIN_CREDENTIALS={"type":"service_account",...}  # one line JSON
#   ADMIN_EMAILS=you@example.com
#
# Optional:
#   NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= / STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET=
#   STRIPE_PRICE_PRO= / STRIPE_PRICE_STUDIO=
#   STRIPE_PRICE_PRO_YEARLY= / STRIPE_PRICE_STUDIO_YEARLY=
#   RESEND_API_KEY= / EMAIL_FROM=
#   CRON_SECRET=
#   NEXT_PUBLIC_SOCIAL_INSTAGRAM= / _TWITTER= / _LINKEDIN= / _YOUTUBE= / _BEHANCE=
#   BILLING_MOCK=true   # only if you want mock upgrades without Stripe
#
# After first deploy: Firebase Console → Authentication → Settings →
# Authorized domains → add YOUR_PROJECT.vercel.app (and custom domain).
# Deploy Firestore/Storage rules: firebase use prod && firebase deploy --only firestore,storage
# Seed templates against prod (with Admin credentials, NOT emulators).
#
# No extra vercel.json routing is required — Next.js is auto-detected.
# Weekly digest cron lives in vercel.json (`/api/cron/weekly-digest`).
